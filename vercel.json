{
    "rewrites": [
      {
        "source": "/(.*)",
        "destination": "/index.html"
      }
    ],
    "git": {
      "deploymentEnabled": false
    },
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "ignoreCommand": "echo 'Ignoring build step for previously built SHA'" 
}
  